{
  "name": "game-workspace",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @game/client --",
    "build": "npm run build -w @game/site",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "simulate": "npm run simulate -w @game/simulate --",
    "deploy": "node -e \"console.error('deploy is not wired yet (epic 1.13)'); process.exit(1)\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "sh scripts/setup-hooks.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
